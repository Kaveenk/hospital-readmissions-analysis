  <worksheets>
    <worksheet name='By Condition. Which conditions drive penalties?'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Penalties are spread evenly across conditions</run>
            <run>Æ&#10;</run>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='10'>% of hospitals above expected readmissions, by condition</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='HRRP Readmissions' name='federated.1legm3a1l44llo11huuxf0x5pfox' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Overall Rate' datatype='real' default-format='p0.0%' name='[Parameter 0090220011536385]' param-domain-type='any' role='measure' type='quantitative' value='0.481'>
              <calculation class='tableau' formula='0.481' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1legm3a1l44llo11huuxf0x5pfox'>
            <column caption='ERR' datatype='real' name='[Calculation_0379597515411457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT([Excess Readmission Ratio])' />
            </column>
            <column caption='Readmissions' datatype='real' name='[Calculation_0379597516247043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT([Number of Readmissions])' />
            </column>
            <column caption='Condition' datatype='string' name='[Calculation_0379597516480516]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Measure Name]&#10;  WHEN &apos;READM-30-AMI-HRRP&apos; THEN &apos;Heart Attack&apos;&#10;  WHEN &apos;READM-30-HF-HRRP&apos; THEN &apos;Heart Failure&apos;&#10;  WHEN &apos;READM-30-PN-HRRP&apos; THEN &apos;Pneumonia&apos;&#10;  WHEN &apos;READM-30-COPD-HRRP&apos; THEN &apos;COPD&apos;&#10;  WHEN &apos;READM-30-CABG-HRRP&apos; THEN &apos;Bypass Surgery (CABG)&apos;&#10;  WHEN &apos;READM-30-HIP-KNEE-HRRP&apos; THEN &apos;Hip/Knee Replacement&apos;&#10;END' />
