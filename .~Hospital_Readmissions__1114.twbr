      <column caption='# Hospitals' datatype='integer' name='[Calculation_0090219990020096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Facility ID])' />
      </column>
      <column caption='# Conditions Reported' datatype='integer' name='[Calculation_0196116737421312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Facility ID] : COUNT([Calculation_0379597515411457]) }' />
      </column>
      <column caption='ERR' datatype='real' name='[Calculation_0379597515411457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([Excess Readmission Ratio])' />
      </column>
      <column caption='Discharges' datatype='real' name='[Calculation_0379597515882498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([Number of Discharges])' />
      </column>
      <column caption='Readmissions' datatype='real' name='[Calculation_0379597516247043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([Number of Readmissions])' />
      </column>
      <column caption='Condition' datatype='string' name='[Calculation_0379597516480516]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Measure Name]&#10;  WHEN &apos;READM-30-AMI-HRRP&apos; THEN &apos;Heart Attack&apos;&#10;  WHEN &apos;READM-30-HF-HRRP&apos; THEN &apos;Heart Failure&apos;&#10;  WHEN &apos;READM-30-PN-HRRP&apos; THEN &apos;Pneumonia&apos;&#10;  WHEN &apos;READM-30-COPD-HRRP&apos; THEN &apos;COPD&apos;&#10;  WHEN &apos;READM-30-CABG-HRRP&apos; THEN &apos;Bypass Surgery (CABG)&apos;&#10;  WHEN &apos;READM-30-HIP-KNEE-HRRP&apos; THEN &apos;Hip/Knee Replacement&apos;&#10;END' />
      </column>
      <column caption='Star Rating' datatype='string' name='[Calculation_0379597517434885]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR(INT([Hospital overall rating])) + &apos; stars&apos;, &apos;Not rated&apos;)' />
      </column>
      <column caption='Performance Band' datatype='string' name='[Calculation_0379597517754374]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0379597515411457] &gt; 1 THEN &apos;Above expected&apos;&#10;ELSEIF [Calculation_0379597515411457] &lt;= 1 THEN &apos;At or below expected&apos;&#10;ELSE &apos;Not reported&apos;&#10;END' />
      </column>
      <column caption='Avg ERR' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_0379597517926407]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_0379597515411457])' />
      </column>
      <column caption='% Above Expected' datatype='real' default-format='p0.0%' name='[Calculation_0379597518245896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0379597515411457] &gt; 1 THEN 1 ELSE 0 END) / SUM(IF NOT ISNULL([Calculation_0379597515411457]) THEN 1 END)' />
      </column>
      <column caption='Hospital Penalized Flag' datatype='integer' name='[Calculation_0379597518925833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Facility ID] : MAX(IF [Calculation_0379597515411457] &gt; 1 THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='# Hospitals Penalized' datatype='integer' name='[Calculation_0379597519126538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_0379597518925833] = 1 THEN [Facility ID] END)' />
      </column>
      <column caption='Hospital Avg ERR' datatype='real' name='[Calculation_0379597519286283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Facility ID] : AVG([Calculation_0379597515411457]) }' />
      </column>
      <column caption='Map Metric' datatype='real' name='[Calculation_0379597521195021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0379597519540236]&#10;  WHEN &apos;Avg ERR&apos; THEN [Calculation_0379597517926407]&#10;  WHEN &apos;% Above Expected&apos; THEN [Calculation_0379597518245896]&#10;  WHEN &apos;Total Readmissions&apos; THEN SUM([Calculation_0379597516247043])&#10;END' />
      </column>
