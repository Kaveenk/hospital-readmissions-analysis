    <worksheet name='Star Rating vs ERR. Do better-rated hospitals readmit less?'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Higher-rated hospitals readmit fewer patients than expected</run>
            <run>Æ&#10;</run>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='10'>Each dot = one hospital’s average excess readmission ratio. Below 1.0 = better than expected.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='HRRP Readmissions' name='federated.1legm3a1l44llo11huuxf0x5pfox' />
            <datasource name='Parameters' />
